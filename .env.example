# Copy to `.env` and adjust. docker-compose reads this file automatically.
# Sensible defaults are baked into docker-compose.yml, so the stack also runs
# without a .env file — but you SHOULD set a real SECRET_KEY for anything public.

# --- Host ports ---
# Override these if another project on your machine already publishes one of them.
# A port that is already taken does NOT fail loudly: Docker still starts the container
# and the other service keeps answering, so connections fail with a confusing
# authentication error instead of a bind error.
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Postgres ---
# These initialise the database on FIRST boot only. Changing them later has no effect
# until you remove the volume (docker compose down -v).
POSTGRES_DB=wikiverse
POSTGRES_USER=wikiverse
POSTGRES_PASSWORD=wikiverse

# --- Django ---
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api
