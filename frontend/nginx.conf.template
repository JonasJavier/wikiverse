# Wikiverse SPA + reverse proxy.
#
# Rendered by the nginx image's entrypoint, which runs envsubst over this file.
# Only names that exist in the environment are substituted, so nginx's own
# runtime variables ($remote_addr, $uri, ...) pass through untouched.
#
# BACKEND_ORIGIN / BACKEND_HOST are supplied by Railway. They used to be
# hardcoded here, which silently coupled this file to one backend deployment:
# renaming the backend service broke the frontend with no error anywhere in
# this repo.

# envsubst only runs over this template, not over included files, so the two
# values the proxy needs are captured here into ordinary nginx variables and
# the include below stays static.
map $host $wikiverse_backend_host {
    default "${BACKEND_HOST}";
}

# Kept in step with apps/common/middleware.py, which emits the same policy for
# responses served directly by Django. Both paths need it: the backend is
# publicly reachable on its own hostname and does not go through this proxy.
map $host $wikiverse_csp {
    default "default-src 'self'; img-src 'self' https://upload.wikimedia.org https://commons.wikimedia.org data:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://*.sentry.io; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'";
}

map $http_user_agent $wikiverse_crawler {
    default                     0;
    # Social and link-preview crawlers do not execute JavaScript, so they would
    # only ever see the site-level card baked into index.html. Route just these
    # to the Open Graph shell; everything else, including humans and Googlebot
    # (which does render JS), gets the SPA.
    ~*facebookexternalhit       1;
    ~*Twitterbot                1;
    ~*Slackbot                  1;
    ~*LinkedInBot               1;
    ~*WhatsApp                  1;
    ~*TelegramBot               1;
    ~*Discordbot                1;
    ~*Pinterest                 1;
    ~*redditbot                 1;
    ~*Applebot                  1;
    ~*SkypeUriPreview           1;
    ~*embedly                   1;
    ~*quora\ link\ preview      1;
    ~*vkShare                   1;
    ~*W3C_Validator             1;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;

    # Compress text responses. The Vite build already ships hashed assets, so
    # this only has to cover what is not precompressed.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain text/css text/xml application/javascript
        application/json application/xml image/svg+xml
        application/rss+xml application/manifest+json;

    # ---------------------------------------------------------------------
    # Backend proxies. Single origin, so the SPA needs no CORS preflight.
    # ---------------------------------------------------------------------
    location /api/ {
        proxy_pass ${BACKEND_ORIGIN}/api/;
        include /etc/nginx/conf.d/wikiverse_proxy.inc;
    }

    location /admin/ {
        proxy_pass ${BACKEND_ORIGIN}/admin/;
        include /etc/nginx/conf.d/wikiverse_proxy.inc;
    }

    location /static/ {
        proxy_pass ${BACKEND_ORIGIN}/static/;
        include /etc/nginx/conf.d/wikiverse_proxy.inc;
    }

    location /media/ {
        proxy_pass ${BACKEND_ORIGIN}/media/;
        include /etc/nginx/conf.d/wikiverse_proxy.inc;
    }

    # Crawler-facing documents the backend generates. sitemap.xml and robots.txt
    # must be served from the site's own origin to be valid for it.
    location = /robots.txt {
        proxy_pass ${BACKEND_ORIGIN}/robots.txt;
        include /etc/nginx/conf.d/wikiverse_proxy.inc;
    }

    location = /sitemap.xml {
        proxy_pass ${BACKEND_ORIGIN}/sitemap.xml;
        include /etc/nginx/conf.d/wikiverse_proxy.inc;
    }

    # ---------------------------------------------------------------------
    # Article pages: the SPA for humans, the Open Graph shell for crawlers.
    # Only the bare article URL is mapped; /wiki/<slug>/history and friends
    # stay with the SPA because nothing links-previews them.
    # ---------------------------------------------------------------------
    location ~ ^/wiki/(?<wiki_slug>[^/]+)/?$ {
        if ($wikiverse_crawler) {
            proxy_pass ${BACKEND_ORIGIN}/og/wiki/$wiki_slug/;
        }

        add_header Content-Security-Policy $wikiverse_csp always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "no-cache" always;

        try_files $uri /index.html;
    }

    # ---------------------------------------------------------------------
    # Static assets. Vite fingerprints these, so they are immutable.
    # ---------------------------------------------------------------------
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /fonts/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Access-Control-Allow-Origin "*";
    }

    # ---------------------------------------------------------------------
    # SPA fallback. index.html must never be cached or a deploy takes hours
    # to reach anyone holding a stale copy.
    # ---------------------------------------------------------------------
    location / {
        add_header Content-Security-Policy $wikiverse_csp always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()" always;

        location = /index.html {
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Content-Security-Policy $wikiverse_csp always;
        }

        try_files $uri $uri/ /index.html;
    }
}
